<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="40dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIAGNOSTIC &amp; PERFORMANCE AUDIT"
                    android:textColor="@color/primary_indigo"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_diag_pagesize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memory Page Size: 16384 bytes (16KB Compatible)"
                    android:textColor="@color/accent_sky"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_diag_abi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Architecture: arm64-v8a"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_diag_memory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VmRSS / VmPeak: Calculating..."
                    android:textColor="@color/accent_emerald"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_diag_api"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Host Android Version: API 34+ (Android 16 Ready)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_diag_toggle_capture"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:text="Start Capture"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_diag_clear"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Clear Logs"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_diag_export_logcat"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:text="Export Logcat"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_diag_generate_report"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_secondary"
                android:text="JSON Report"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE LOGCAT GENERATOR STREAM"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_diag_logs"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/bg_card_glass"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:text="[INFO] VirtualCore Logcat Generator Ready.\n[INFO] Tap 'Start Capture' to stream live logs or 'JSON Report' to generate diagnostic telemetry." />

    </LinearLayout>
</ScrollView>