<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUK PANEL LICENSE"
                    android:textColor="@color/primary_indigo"
                    android:textStyle="bold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_sec_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_emerald"
                    android:text="ACTIVATED"
                    android:textColor="@color/accent_emerald"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tv_sec_endpoint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Endpoint: https://ruk-panel.onrender.com/api/connect"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_sec_key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="License Key: RUK-TZR1-8MD3-PP4M"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tv_sec_hwid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device HWID: Linked"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/btn_verify_license"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Re-Verify License"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Integrity Center Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENVIRONMENT INTEGRITY"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[OK] Core JNI Engine: Healthy (16KB Page Aligned)"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[OK] Virtual Storage Sandbox: Isolated"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[OK] Native /proc/self/maps Cloaking: Active"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[OK] Anti-Debugging (TracerPid: 0): Active"
                android:textColor="@color/accent_emerald"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>